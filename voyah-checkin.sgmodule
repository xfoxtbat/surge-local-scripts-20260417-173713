#!name=岚图汽车每日签到
#!desc=v7.2: 单文件双模式。打开岚图微信小程序自动获取Cookie，每天8:00自动签到；已修复真实签到接口与 JS 相对路径问题。
#!category=Task
#!version=7.2.1

[MITM]
hostname = %APPEND% *.voyah.com.cn

[Script]
岚图-抓取Cookie = type=http-request,pattern=^https://.*\.voyah\.com\.cn/mygateway/,requires-body=0,max-size=0,script-path=voyah-checkin.js,script-update-interval=0,timeout=10
岚图-每日签到 = type=cron,cronexp=0 8 * * *,script-path=voyah-checkin.js,script-update-interval=0,timeout=30
